<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ══════════════════════════════════════════════
             Extend crm.lead form — Facebook Info tab
        ══════════════════════════════════════════════ -->
        <record id="crm_lead_view_form_facebook" model="ir.ui.view">
            <field name="name">crm.lead.form.facebook</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <xpath expr='//page[@name="lead"]' position='after'>
                    <page name="facebook_info" string="Facebook Info"
                          invisible="not facebook_lead_id">
                        <group name="facebook_info_group" string="Facebook Info">
                            <field name="facebook_lead_id"/>
                            <field name="facebook_date_create"/>
                            <field name="facebook_page_id"/>
                            <field name="facebook_form_id"/>
                            <field name="facebook_adset_id"/>
                            <field name="facebook_ad_id"/>
                            <field name="facebook_campaign_id"/>
                            <field name="facebook_is_organic"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- ══════════════════════════════════════════════
             crm.facebook.page views
        ══════════════════════════════════════════════ -->
        <record id="crm_facebook_page_form" model="ir.ui.view">
            <field name="name">crm.facebook.page.form</field>
            <field name="model">crm.facebook.page</field>
            <field name="arch" type="xml">
                <form string="Facebook Page">
                    <header>
                        <button name="get_forms" type="object" string="Get Forms"
                                class="btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="label"/>
                            <field name="name"/>
                            <field name="access_token" class="oe_edit_only"/>
                        </group>
                        <group>
                            <field name="form_ids"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="crm_facebook_page_list" model="ir.ui.view">
            <field name="name">crm.facebook.page.list</field>
            <field name="model">crm.facebook.page</field>
            <field name="arch" type="xml">
                <list string="Facebook Pages">
                    <field name="label"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_crm_facebook_page">
            <field name="name">Facebook Pages</field>
            <field name="res_model">crm.facebook.page</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="crm_facebook_page_list"/>
            <field name="help" type="html"><p></p></field>
        </record>

        <menuitem
            id="menu_crm_facebook_page"
            name="Facebook Pages"
            parent="crm.menu_crm_config_lead"
            sequence="100"
            action="action_crm_facebook_page"
            groups="sales_team.group_sale_manager"/>

        <!-- ══════════════════════════════════════════════
             crm.facebook.form views
        ══════════════════════════════════════════════ -->
        <record id="crm_facebook_form_form" model="ir.ui.view">
            <field name="name">crm.facebook.form.form</field>
            <field name="model">crm.facebook.form</field>
            <field name="arch" type="xml">
                <form string="Facebook Form">
                    <header>
                        <button name="get_fields" type="object" string="Get Fields"
                                class="btn-primary"/>
                        <button name="action_guess_mapping" type="object"
                                string="Guess Mapping"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="team_id"/>
                            </group>
                            <group>
                                <field name="page_id" readonly="True"/>
                                <field name="facebook_form_id" readonly="True"/>
                                <field name="date_retrieval"/>
                                <field name="access_token" invisible="True"/>
                            </group>
                            <group string="Tracking Info">
                                <field name="campaign_id"/>
                                <field name="medium_id"/>
                                <field name="source_id"/>
                            </group>
                        </group>
                        <group string="Mappings">
                            <field name="mappings">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="facebook_field"/>
                                    <field name="odoo_field"/>
                                    <button name="action_guess_mapping"
                                            type="object"
                                            icon="fa-question-circle text-info"
                                            string="Guess Mapping"
                                            invisible="odoo_field"/>
                                </list>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="crm_facebook_form_list" model="ir.ui.view">
            <field name="name">crm.facebook.form.list</field>
            <field name="model">crm.facebook.form</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="facebook_form_id" readonly="True"/>
                    <field name="page_id" readonly="True"/>
                    <field name="team_id"/>
                </list>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_crm_facebook_form">
            <field name="name">Facebook Forms</field>
            <field name="res_model">crm.facebook.form</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="crm_facebook_form_list"/>
            <field name="help" type="html"><p></p></field>
        </record>

        <menuitem
            id="menu_crm_facebook_form"
            name="Facebook Forms"
            parent="crm.menu_crm_config_lead"
            sequence="101"
            action="action_crm_facebook_form"
            groups="sales_team.group_sale_manager"/>

        <!-- ══════════════════════════════════════════════
             crm.facebook.form.mapping views
        ══════════════════════════════════════════════ -->
        <record id="crm_facebook_form_mapping_form" model="ir.ui.view">
            <field name="name">crm.facebook.form.mapping.form</field>
            <field name="model">crm.facebook.form.mapping</field>
            <field name="arch" type="xml">
                <form string="Default Field Mapping">
                    <group>
                        <field name="facebook_field"/>
                        <field name="odoo_field"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="crm_facebook_form_mapping_list" model="ir.ui.view">
            <field name="name">crm.facebook.form.mapping.list</field>
            <field name="model">crm.facebook.form.mapping</field>
            <field name="arch" type="xml">
                <list>
                    <field name="facebook_field"/>
                    <field name="odoo_field"/>
                </list>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_crm_facebook_form_mapping">
            <field name="name">Default Mappings</field>
            <field name="res_model">crm.facebook.form.mapping</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="crm_facebook_form_mapping_list"/>
            <field name="help" type="html"><p></p></field>
        </record>

        <menuitem
            id="menu_crm_facebook_form_mapping"
            name="Default Mappings"
            parent="crm.menu_crm_config_lead"
            sequence="102"
            action="action_crm_facebook_form_mapping"
            groups="sales_team.group_sale_manager"/>

    </data>
</odoo>
