<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_facebook" model="ir.ui.view">
        <field name="name">res.config.settings.facebook</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Facebook Leads"
                     string="Facebook Leads" data-key="meta_crm_facebook_leads">
                    <h2>Facebook Lead Ads Settings</h2>
                    <div id="crm_facebook_settings">
                        <div class="row mt16 o_settings_container">

                            <div class="col-6 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">
                                        Option 1 (Advanced): Use your own Facebook App
                                    </span>
                                    <div class="text-muted">
                                        Create a Facebook App
                                        <a href="https://developers.facebook.com/apps" target="_blank">here</a>
                                        and get the <strong>App ID</strong> and <strong>App Secret</strong>.
                                        Your app must undergo App Review and be Live.
                                    </div>
                                    <div class="content-group mt8">
                                        <div class="row">
                                            <label for="crm_fb_app_id" class="col-md-3 o_light_label"/>
                                            <field name="crm_fb_app_id"/>
                                        </div>
                                        <div class="row">
                                            <label for="crm_fb_app_secret" class="col-md-3 o_light_label"/>
                                            <field name="crm_fb_app_secret"/>
                                        </div>
                                        <div invisible="not crm_fb_app_id or not crm_fb_app_secret">
                                            <button type="object" name="action_get_access_token"
                                                    string="Get Access Token"
                                                    icon="fa-arrow-right" class="btn-link"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">
                                        Option 2 (Easy): Use Our Facebook App
                                    </span>
                                    <div class="text-muted">
                                        Use this option if you do not have a reviewed Facebook App.
                                    </div>
                                    <div class="content-group mt8">
                                        <div class="mt16">
                                            <a target="_blank" class="oe_link"
                                               href="https://www.facebook.com/dialog/oauth?response_type=token&amp;client_id=165653190816042&amp;redirect_uri=https%3A%2F%2Fbadep.ma%2Fauth_oauth%2Fsignin&amp;scope=public_profile%2Cemail%2Cleads_retrieval%2Cpages_manage_ads%2Cpages_read_engagement%2Cads_management">
                                                <i class="fa fa-arrow-right"/> Use Odoo CRM Connector
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">User Access Token</span>
                                    <div class="text-muted">
                                        Manually enter the long-lived User Access Token or use
                                        the <strong>Get Access Token</strong> button above.
                                    </div>
                                    <div class="content-group mt8">
                                        <div class="row">
                                            <label for="crm_fb_access_token" class="col-md-3 o_light_label"/>
                                            <field name="crm_fb_access_token"/>
                                        </div>
                                        <div invisible="not crm_fb_access_token">
                                            <button type="object" name="action_get_facebook_pages"
                                                    string="Get Pages"
                                                    icon="fa-arrow-right" class="btn-link"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
