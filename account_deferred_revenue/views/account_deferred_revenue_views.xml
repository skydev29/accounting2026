<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Form view ──────────────────────────────────────────────────────── -->
    <record id="view_deferred_revenue_form" model="ir.ui.view">
        <field name="name">account.deferred.revenue.form</field>
        <field name="model">account.deferred.revenue</field>
        <field name="arch" type="xml">
            <form string="Deferred Revenue">
                <header>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_close"
                            string="Close"
                            type="object"
                            invisible="state != 'in_progress'"/>
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,closed"/>
                </header>
                <sheet>
                    <!-- Smart button: journal entries -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book"
                                invisible="move_count == 0">
                            <field name="move_count" widget="statinfo" string="Entries"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="state != 'draft'"/>
                        </h1>
                    </div>

                    <group>
                        <group string="General">
                            <field name="template_id"
                                   readonly="state != 'draft'"/>
                            <field name="partner_id"
                                   readonly="state != 'draft'"/>
                            <field name="invoice_line_id"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id"
                                   groups="base.group_multi_currency"
                                   readonly="state != 'draft'"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group string="Amounts &amp; Dates">
                            <field name="total_amount"
                                   readonly="state != 'draft'"/>
                            <field name="recognized_amount"/>
                            <field name="remaining_amount"/>
                            <field name="date_start"
                                   readonly="state != 'draft'"/>
                            <field name="date_end"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <group string="Accounting">
                        <field name="journal_id"
                               readonly="state != 'draft'"/>
                        <field name="deferred_account_id"
                               readonly="state != 'draft'"/>
                        <field name="recognition_account_id"
                               readonly="state != 'draft'"/>
                    </group>

                    <notebook>
                        <page string="Recognition Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'posted'"
                                           decoration-warning="state == 'pending'"/>
                                    <field name="move_id"/>
                                    <button name="action_post_entry"
                                            type="object"
                                            string="Post"
                                            icon="fa-check"
                                            invisible="state == 'posted'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description" placeholder="Additional details…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── List view ──────────────────────────────────────────────────────── -->
    <record id="view_deferred_revenue_list" model="ir.ui.view">
        <field name="name">account.deferred.revenue.list</field>
        <field name="model">account.deferred.revenue</field>
        <field name="arch" type="xml">
            <list string="Deferred Revenue"
                  decoration-muted="state == 'closed'"
                  decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="total_amount"/>
                <field name="recognized_amount"/>
                <field name="remaining_amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'in_progress'"
                       decoration-warning="state == 'closed'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ── Search view ────────────────────────────────────────────────────── -->
    <record id="view_deferred_revenue_search" model="ir.ui.view">
        <field name="name">account.deferred.revenue.search</field>
        <field name="model">account.deferred.revenue</field>
        <field name="arch" type="xml">
            <search string="Deferred Revenue">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="template_id"/>
                <!-- Filters -->
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="filter_in_progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter string="Closed" name="filter_closed"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="My Company" name="filter_my_company"
                        domain="[('company_id', '=', allowed_company_ids[0])]"/>
                <separator/>
                <filter string="Partner" name="group_partner"
                        context="{'group_by': 'partner_id'}"/>
                <filter string="Status" name="group_state"
                        context="{'group_by': 'state'}"/>
                <filter string="Start Date" name="group_date_start"
                        context="{'group_by': 'date_start:month'}"/>
                <filter string="Template" name="group_template"
                        context="{'group_by': 'template_id'}"/>
            </search>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────────────────────── -->
    <record id="action_deferred_revenue" model="ir.actions.act_window">
        <field name="name">Deferred Revenue</field>
        <field name="res_model">account.deferred.revenue</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_deferred_revenue_search"/>
        <field name="context">{'search_default_filter_in_progress': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first deferred revenue record
            </p>
            <p>
                Deferred revenue lets you spread income recognition over a period
                and automatically post journal entries on the recognition dates.
            </p>
        </field>
    </record>

</odoo>
