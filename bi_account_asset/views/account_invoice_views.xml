<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add "Asset Category" to supplier invoices -->

    <record id="view_move_line_form" model="ir.ui.view">
        <field name="name">account.move.line.form.followup</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <field name="date_maturity" position="after">
                <field name="asset_category_id" string="Asset Category"
                       column_invisible="parent.move_type not in ('in_invoice', 'in_refund', 'in_receipt')"/>
            </field>
        </field>
    </record>

    <record id="view_move_form_inherits" model="ir.ui.view">
        <field name="name">account.move.form.followup</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='partner_id']"
                   position="after">
                <field name="asset_category_id" string="Asset Category"
                       column_invisible="parent.move_type not in ('in_invoice', 'in_refund', 'in_receipt')"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//form//field[@name='name']"
                   position="after">
                <field name="asset_category_id" string="Asset Category"
                       invisible="parent.move_type not in ('in_invoice', 'in_refund', 'in_receipt')"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']//form//field[@name='account_id']"
                   position="after">
                <field name="asset_category_id" string="Asset Category" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
