<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Sequence for Internal Transfer references.
            prefix = INT/  |  padding = 5  →  INT/00001, INT/00002, …
            company_id = False → single shared sequence across all companies.
            Override with per-company sequences in multi-company setups.
        -->
        <record id="seq_account_internal_transfer" model="ir.sequence">
            <field name="name">Internal Transfer</field>
            <field name="code">account.internal.transfer</field>
            <field name="prefix">INT/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
