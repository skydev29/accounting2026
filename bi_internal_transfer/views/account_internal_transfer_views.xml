<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         FORM VIEW
         ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_account_internal_transfer_form" model="ir.ui.view">
        <field name="name">account.internal.transfer.form</field>
        <field name="model">account.internal.transfer</field>
        <field name="arch" type="xml">
            <form string="Internal Transfer">
                <header>
                    <!-- Primary action: draft → posted -->
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <!-- Secondary: posted → draft (re-opens for editing) -->
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'posted'"/>

                    <!-- Destructive: any → cancelled -->
                    <button name="action_cancel"
                            string="Cancel Transfer"
                            type="object"
                            invisible="state == 'cancelled'"
                            confirm="This will void the linked journal entry. Proceed?"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,posted,cancelled"/>
                </header>

                <sheet>
                    <!-- ── Smart-button area ─────────────────────────────── -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book"
                                invisible="not move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Journal Entry</span>
                            </div>
                        </button>
                    </div>

                    <!-- ── Title ─────────────────────────────────────────── -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="True"/>
                        </h1>
                    </div>

                    <!-- ── Group 1: Transfer Information ─────────────────── -->
                    <group string="Transfer Information">
                        <group>
                            <!-- Hidden helpers supply the journal domain values -->
                            <field name="transfer_icon" invisible="True"/>
                            <field name="transfer_type"
                                   readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <!-- ── Group 2: Journals ──────────────────────────────── -->
                    <!--
                        journal_source_type / journal_dest_type are invisible
                        computed fields whose values are referenced inside the
                        domain attributes of journal_id and dest_journal_id.
                        Odoo 19 evaluates these expressions client-side using
                        the current record's field values.
                    -->
                    <group string="Journals">
                        <group string="Source">
                            <field name="journal_source_type" invisible="True"/>
                            <field name="journal_id"
                                   domain="[('type', '=', journal_source_type), ('company_id', '=', company_id)]"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group string="Destination">
                            <field name="journal_dest_type" invisible="True"/>
                            <field name="dest_journal_id"
                                   domain="[('type', '=', journal_dest_type), ('company_id', '=', company_id)]"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <!-- ── Group 3: Amount ───────────────────────────────── -->
                    <group string="Amount">
                        <group>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id"
                                   groups="base.group_multi_currency"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="memo" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <!-- Hidden: move_id is needed for the smart button test -->
                    <field name="move_id" invisible="True"/>
                </sheet>

                <!-- Chatter / activity thread -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         LIST VIEW
         ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_account_internal_transfer_list" model="ir.ui.view">
        <field name="name">account.internal.transfer.list</field>
        <field name="model">account.internal.transfer</field>
        <field name="arch" type="xml">
            <list string="Internal Transfers"
                  decoration-success="state == 'posted'"
                  decoration-danger="state == 'cancelled'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="date"/>
                <field name="transfer_type"
                       widget="badge"
                       decoration-info="transfer_type == 'cash_to_bank'"
                       decoration-warning="transfer_type == 'bank_to_cash'"
                       decoration-success="transfer_type == 'bank_to_bank'"
                       decoration-danger="transfer_type == 'cash_to_cash'"/>
                <field name="journal_id"/>
                <field name="dest_journal_id"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         SEARCH VIEW
         ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_account_internal_transfer_search" model="ir.ui.view">
        <field name="name">account.internal.transfer.search</field>
        <field name="model">account.internal.transfer</field>
        <field name="arch" type="xml">
            <search string="Internal Transfers">
                <!-- Full-text search fields -->
                <field name="name" string="Reference"/>
                <field name="memo" string="Memo"/>
                <field name="journal_id" string="Source Journal"/>
                <field name="dest_journal_id" string="Destination Journal"/>

                <!-- State filters -->
                <filter string="Draft"
                        name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Posted"
                        name="filter_posted"
                        domain="[('state', '=', 'posted')]"/>
                <filter string="Cancelled"
                        name="filter_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>

                <!-- Type filters -->
                <filter string="Cash → Bank"
                        name="filter_cash_to_bank"
                        domain="[('transfer_type', '=', 'cash_to_bank')]"/>
                <filter string="Bank → Cash"
                        name="filter_bank_to_cash"
                        domain="[('transfer_type', '=', 'bank_to_cash')]"/>
                <filter string="Bank → Bank"
                        name="filter_bank_to_bank"
                        domain="[('transfer_type', '=', 'bank_to_bank')]"/>
                <filter string="Cash → Cash"
                        name="filter_cash_to_cash"
                        domain="[('transfer_type', '=', 'cash_to_cash')]"/>
                <separator/>

                <!-- Group-by -->
                <filter string="Transfer Type"
                        name="group_transfer_type"
                        context="{'group_by': 'transfer_type'}"/>
                <filter string="Source Journal"
                        name="group_journal"
                        context="{'group_by': 'journal_id'}"/>
                <filter string="Date (Month)"
                        name="group_date_month"
                        context="{'group_by': 'date:month'}"/>
                <filter string="Status"
                        name="group_state"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         ACTION
         ══════════════════════════════════════════════════════════════════════ -->
    <record id="action_account_internal_transfer" model="ir.actions.act_window">
        <field name="name">Internal Transfers</field>
        <field name="res_model">account.internal.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_account_internal_transfer_search"/>
        <field name="context">{'search_default_filter_posted': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first internal transfer
            </p>
            <p>
                Move funds between your cash registers and bank accounts.
                Confirming a transfer automatically posts the corresponding
                journal entry.
            </p>
        </field>
    </record>

</odoo>
