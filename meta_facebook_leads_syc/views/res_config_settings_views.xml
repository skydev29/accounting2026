<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="res_config_settings_view_form_facebook" model="ir.ui.view">
    <field name="name">res.config.settings.facebook</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
        <xpath expr="//form" position="inside">
            <div class="app_settings_block"
                 data-string="Facebook Lead Ads"
                 string="Facebook Lead Ads"
                 data-key="meta_facebook_leads_syc">

                <h2>
                    <i class="fa fa-facebook-square me-2 text-primary"/>
                    Facebook Lead Ads
                </h2>
                <p class="text-muted">
                    Automatically sync Facebook Lead Ads into Odoo CRM.
                </p>

                <div class="row mt16 o_settings_container">

                    <!-- ── Connection status ──────────────────────── -->
                    <div class="col-12 o_setting_box">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label fw-bold">Connection</span>

                            <!-- Connected -->
                            <div class="d-flex align-items-center gap-2 mt-2 mb-3"
                                 invisible="not crm_fb_access_token">
                                <i class="fa fa-check-circle text-success fa-lg"/>
                                <span class="text-success fw-bold">Connected</span>
                                <span class="text-muted small ms-1">
                                    — Access token is configured.
                                </span>
                            </div>

                            <!-- Not connected -->
                            <div class="d-flex align-items-center gap-2 mt-2 mb-3"
                                 invisible="crm_fb_access_token">
                                <i class="fa fa-times-circle text-danger fa-lg"/>
                                <span class="text-muted fw-bold">Not connected</span>
                                <span class="text-muted small ms-1">
                                    — Run the setup wizard to connect.
                                </span>
                            </div>

                            <button type="object"
                                    name="action_open_setup_wizard"
                                    string="Setup Wizard"
                                    icon="fa-magic"
                                    class="btn btn-primary btn-sm"/>

                        </div>
                    </div>

                    <!-- ── Import pages shortcut ──────────────────── -->
                    <div class="col-12 o_setting_box"
                         invisible="not crm_fb_access_token">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label fw-bold">Quick Actions</span>
                            <div class="text-muted small mb-2">
                                Re-import pages or jump straight to configuration.
                            </div>
                            <div class="d-flex gap-2 flex-wrap">
                                <button type="object"
                                        name="action_get_facebook_pages"
                                        string="Re-import Pages"
                                        icon="fa-refresh"
                                        class="btn btn-outline-secondary btn-sm"/>
                            </div>
                        </div>
                    </div>

                    <!-- ── Advanced ───────────────────────────────── -->
                    <div class="col-12 o_setting_box">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label fw-bold">Advanced</span>
                            <div class="text-muted small mb-2">
                                Override the Facebook Graph API version
                                (default: <code>v21.0</code>).
                            </div>
                            <div class="row">
                                <label for="crm_fb_api_version"
                                       class="col-md-2 o_light_label"/>
                                <div class="col-md-4">
                                    <field name="crm_fb_api_version"
                                           placeholder="v21.0"/>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </xpath>
    </field>
</record>
</odoo>
