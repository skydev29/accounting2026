<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Form view ──────────────────────────────────────────────────────── -->
    <record id="view_deferred_expense_template_form" model="ir.ui.view">
        <field name="name">muknon.deferred.expense.template.form</field>
        <field name="model">muknon.deferred.expense.template</field>
        <field name="arch" type="xml">
            <form string="Deferred Expense Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Template Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Accounting">
                            <field name="journal_id"/>
                            <field name="deferred_account_id"/>
                            <field name="expense_account_id"/>
                            <field name="recognition_period"/>
                        </group>
                        <group string="Settings">
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Internal notes…"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── List view ──────────────────────────────────────────────────────── -->
    <record id="view_deferred_expense_template_list" model="ir.ui.view">
        <field name="name">muknon.deferred.expense.template.list</field>
        <field name="model">muknon.deferred.expense.template</field>
        <field name="arch" type="xml">
            <list string="Deferred Expense Templates">
                <field name="name"/>
                <field name="journal_id"/>
                <field name="deferred_account_id"/>
                <field name="expense_account_id"/>
                <field name="recognition_period"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────────────────────── -->
    <record id="action_deferred_expense_template" model="ir.actions.act_window">
        <field name="name">Deferred Expense Templates</field>
        <field name="res_model">muknon.deferred.expense.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
