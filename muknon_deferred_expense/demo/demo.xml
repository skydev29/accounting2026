<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Demo deferred expense in draft state.
            Journal and accounts are intentionally omitted so the record
            can load in any database; fill them in after confirming the record.
        -->
        <record id="demo_deferred_expense_01" model="muknon.deferred.expense">
            <field name="name">Annual Software Subscription 2026</field>
            <field name="partner_id" ref="base.res_partner_12"/>
            <field name="total_amount">12000.00</field>
            <field name="date_start">2026-01-01</field>
            <field name="date_end">2026-12-31</field>
            <field name="description">
                Annual SaaS subscription fee paid upfront on 1 Jan 2026.
                Cost to be amortised equally over 12 months.
                Set the journal and accounts, then click Confirm.
            </field>
        </record>
    </data>
</odoo>
