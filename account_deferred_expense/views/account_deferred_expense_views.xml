<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Form view ──────────────────────────────────────────────────────── -->
    <record id="view_deferred_expense_form" model="ir.ui.view">
        <field name="name">account.deferred.expense.form</field>
        <field name="model">account.deferred.expense</field>
        <field name="arch" type="xml">
            <form string="Deferred Expense">
                <header>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_close"
                            string="Close"
                            type="object"
                            invisible="state != 'in_progress'"/>
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,closed"/>
                </header>
                <sheet>
                    <!-- Smart button: journal entries -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book"
                                invisible="move_count == 0">
                            <field name="move_count" widget="statinfo" string="Entries"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="state != 'draft'"/>
                        </h1>
                    </div>

                    <!-- Info banner in draft state -->
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'draft'">
                        Confirm this record to automatically generate the recognition schedule.
                    </div>

                    <group>
                        <group string="General">
                            <field name="template_id"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id"
                                   groups="base.group_multi_currency"
                                   readonly="state != 'draft'"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group string="Amounts &amp; Dates">
                            <field name="total_amount"
                                   readonly="state != 'draft'"/>
                            <field name="recognized_amount"/>
                            <field name="remaining_amount"/>
                            <field name="date_start"
                                   readonly="state != 'draft'"/>
                            <field name="date_end"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Tab 1: Recognition Schedule -->
                        <page string="Recognition Schedule">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'posted'"
                                           decoration-warning="state == 'pending'"/>
                                    <field name="move_id"/>
                                    <button name="action_post_entry"
                                            type="object"
                                            string="Post"
                                            icon="fa-check"
                                            invisible="state == 'posted'"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="recognized_amount"
                                       string="Recognized"
                                       class="oe_subtotal_footer_separator"/>
                                <field name="remaining_amount"
                                       string="Remaining"/>
                            </group>
                        </page>

                        <!-- Tab 2: Settings -->
                        <page string="Settings">
                            <group>
                                <group string="Accounting">
                                    <field name="journal_id"
                                           readonly="state != 'draft'"/>
                                    <field name="deferred_account_id"
                                           readonly="state != 'draft'"/>
                                    <field name="expense_account_id"
                                           readonly="state != 'draft'"/>
                                </group>
                                <group string="Other">
                                    <field name="partner_id"
                                           readonly="state != 'draft'"/>
                                    <field name="bill_line_id"
                                           readonly="state != 'draft'"/>
                                    <field name="analytic_distribution"
                                           widget="analytic_distribution"
                                           readonly="state != 'draft'"/>
                                </group>
                            </group>
                            <group string="Description">
                                <field name="description"
                                       nolabel="1"
                                       placeholder="Additional details…"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── List view ──────────────────────────────────────────────────────── -->
    <record id="view_deferred_expense_list" model="ir.ui.view">
        <field name="name">account.deferred.expense.list</field>
        <field name="model">account.deferred.expense</field>
        <field name="arch" type="xml">
            <list string="Deferred Expenses"
                  decoration-muted="state == 'closed'"
                  decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="total_amount" sum="Total"/>
                <field name="recognized_amount" sum="Recognized"/>
                <field name="remaining_amount" sum="Remaining"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'in_progress'"
                       decoration-warning="state == 'closed'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ── Search view ────────────────────────────────────────────────────── -->
    <record id="view_deferred_expense_search" model="ir.ui.view">
        <field name="name">account.deferred.expense.search</field>
        <field name="model">account.deferred.expense</field>
        <field name="arch" type="xml">
            <search string="Deferred Expenses">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="template_id"/>
                <!-- State filters -->
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="filter_in_progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter string="Closed" name="filter_closed"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <!-- Overdue: has pending lines with date < today -->
                <filter string="Overdue" name="filter_overdue"
                        domain="[('line_ids.date', '&lt;', context_today().strftime('%Y-%m-%d')),
                                 ('line_ids.move_id', '=', False),
                                 ('state', '=', 'in_progress')]"/>
                <separator/>
                <!-- Group by -->
                <filter string="Partner" name="group_partner"
                        context="{'group_by': 'partner_id'}"/>
                <filter string="Status" name="group_state"
                        context="{'group_by': 'state'}"/>
                <filter string="Start Month" name="group_date_start"
                        context="{'group_by': 'date_start:month'}"/>
            </search>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────────────────────── -->
    <record id="action_deferred_expense" model="ir.actions.act_window">
        <field name="name">Deferred Expenses</field>
        <field name="res_model">account.deferred.expense</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_deferred_expense_search"/>
        <field name="context">{'search_default_filter_in_progress': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first deferred expense record
            </p>
            <p>
                Deferred expenses let you spread prepaid costs over their
                benefit period and automatically post journal entries on
                the recognition dates.
            </p>
        </field>
    </record>

</odoo>
